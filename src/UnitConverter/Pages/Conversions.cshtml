@page "{ConversionType?}/{Input?}"
@model UnitConverter.Pages.ConversionsModel
<h1>@ViewData["ConversionType"]</h1>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title></title>
@if (ViewData["ErrorMessage"] != null)
