@page "{ConversionType?}//{Input?}"
@model UnitConverter.Pages.ConversionsModel
<h1>@ViewData["ConversionType"]</h1>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title></title>
@if (ViewData["ErrorMessage"] != null)
    {
        <p class="text-danger">@ViewData["ErrorMessage"]</p>
    }
else
{
    <p>Input: @Model.Input miles </p>
    <p>Output: @Model.Output kilometers </p>
}

</head>
<body>
<div>

</div>
</body>
</html>
